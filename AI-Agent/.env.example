# ==============================================================================
# SkillFirst Labs AI Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your real Gemini API key:
#   copy .env.example .env (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Get your Gemini API key for free at Google AI Studio:
#   https://aistudio.google.com/
# ==============================================================================

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Name (default: gemini-2.5-flash)
# Supported options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Optional: Maximum multi-turn tool-calling rounds (prevents infinite loops)
MAX_TOOL_TURNS=5

